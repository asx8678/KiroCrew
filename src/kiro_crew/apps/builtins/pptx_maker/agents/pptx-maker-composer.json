{
  "name": "pptx-maker-composer",
  "description": "Slide composer for the presentation engine. Writes slide JSON, builds the .pptx, measures it and polishes autonomously. Runs as a sub-agent with no user interaction.",
  "includeMcpJson": false,
  "mcpServers": {
    "sdpm": {
      "command": "{UV_BIN}",
      "args": ["run", "--directory", "{ENGINE_MCP_DIR}", "python", "server_acp.py"],
      "env": { "PYTHONPATH": "", "PATH": "{TOOLS_PATH}" },
      "timeout": 120000
    }
  },
  "prompt": "file://{ENGINE_ROOT}/mcp-local/acp-agent-prompts/composer.md",
  "resources": [
    "file://{ENGINE_ROOT}/skill/references/slide-json-spec.md"
  ],
  "tools": [
    "@sdpm/analyze_template", "@sdpm/apply_style", "@sdpm/code_to_slide",
    "@sdpm/generate_pptx", "@sdpm/grid", "@sdpm/import_attachment",
    "@sdpm/init_presentation", "@sdpm/list_asset_sources", "@sdpm/list_guides",
    "@sdpm/list_styles", "@sdpm/list_templates", "@sdpm/list_workflows",
    "@sdpm/measure_slides", "@sdpm/pptx_to_json", "@sdpm/read_examples",
    "@sdpm/read_guides", "@sdpm/read_workflows", "@sdpm/run_python",
    "@sdpm/search_assets", "read", "glob", "grep"
  ],
  "model": "auto"
}
